---
interface Props {
  title: string;
  lede: string;
  probe: string;
  step: string;
  pulses: string;
  events: string;
  caption: string;
  note: string;
  items: readonly { n: string; title: string; body: string }[];
}

const { title, lede, probe, step, pulses, events, caption, note, items } = Astro.props as Props;
---

<section class="section emergence" id="emergencia" aria-labelledby="emergence-title">
  <div class="shell">
    <div class="section__head">
      <div>
        <h2 class="section-title" id="emergence-title">{title}</h2>
      </div>
      <p class="section-lede">{lede}</p>
    </div>

    <figure class="emergence__figure">
      <canvas class="emergence__canvas" aria-hidden="true"></canvas>
      <div
        class="emergence__readout"
        aria-hidden="true"
        data-emergence
        data-probe={probe}
        data-step={step}
        data-pulses={pulses}
        data-events={events}
      >
        <span class="emergence__probe" data-emergence-label>{step}</span>
        <b data-emergence-value>—</b>
        <span data-emergence-unit>{events}</span>
      </div>
      <figcaption class="emergence__caption">{caption}</figcaption>
    </figure>

    <ol class="emergence__items">
      {items.map((item: Props['items'][number]) => (
        <li>
          <span class="emergence__n">{item.n}</span>
          <h3 class="emergence__item-title">{item.title}</h3>
          <p class="emergence__item-body">{item.body}</p>
        </li>
      ))}
    </ol>

    <p class="emergence__note">{note}</p>
  </div>
</section>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.emergence__canvas');
  const root = document.querySelector<HTMLElement>('[data-emergence]');
  const labelEl = document.querySelector<HTMLElement>('[data-emergence-label]');
  const valueEl = document.querySelector<HTMLElement>('[data-emergence-value]');
  const unitEl = document.querySelector<HTMLElement>('[data-emergence-unit]');

  if (canvas && root) {
    const probe = root.dataset.probe ?? 'Capa';
    const stepWord = root.dataset.step ?? 'Paso';
    const pulses = root.dataset.pulses ?? 'pulsos';
    const events = root.dataset.events ?? 'eventos';

    const ctx = canvas.getContext('2d');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const STEPS = 16;
    const PULSES = [3, 5, 4, 7, 2, 6, 3, 5, 4];
    const LAYERS = PULSES.length;

    let w = 0;
    let h = 0;
    let dpr = 1;
    let hover = -1;
    let playhead = 0;
    let stepIndex = 0;
    let raf = 0;
    const triggers = PULSES.map(() => new Array<number>(STEPS).fill(0));

    const hash = (n: number) => {
      const x = Math.sin(n * 127.1 + 311.7) * 43758.5453;
      return x - Math.floor(x);
    };

    const patterns = PULSES.map((k, i) => {
      const rot = Math.floor(hash(i + 3) * STEPS);
      return Array.from({ length: STEPS }, (_, s) => ((s * k + rot) % STEPS) < k);
    });

    const layerY = (i: number) => {
      const pad = 26;
      return pad + ((h - pad * 2) * i) / (LAYERS - 1);
    };

    const draw = () => {
      if (!ctx) return;
      ctx.clearRect(0, 0, w, h);
      const pad = 26;
      const usable = h - pad * 2;
      const stepW = w / STEPS;
      const time = playhead * 9;

      ctx.strokeStyle = 'rgba(233, 228, 216, 0.09)';
      ctx.lineWidth = 1;
      for (let s = 0; s <= STEPS; s += 1) {
        const x = Math.round(s * stepW) + 0.5;
        ctx.strokeStyle =
          s % 4 === 0 ? 'rgba(233, 228, 216, 0.22)' : 'rgba(233, 228, 216, 0.06)';
        ctx.beginPath();
        ctx.moveTo(x, pad - 12);
        ctx.lineTo(x, h - pad + 12);
        ctx.stroke();
      }

      const px = playhead * w;
      ctx.fillStyle = 'rgba(233, 228, 216, 0.05)';
      ctx.fillRect(px, pad - 12, stepW, h - pad * 2 + 24);
      ctx.beginPath();
      ctx.moveTo(px, pad - 12);
      ctx.lineTo(px, h - pad + 12);
      ctx.strokeStyle = 'rgba(233, 228, 216, 0.7)';
      ctx.stroke();

      ctx.beginPath();
      ctx.moveTo(px - 4, pad - 16);
      ctx.lineTo(px + 4, pad - 16);
      ctx.lineTo(px, pad - 9);
      ctx.closePath();
      ctx.fillStyle = 'rgba(233, 228, 216, 0.8)';
      ctx.fill();

      if (hover >= 0) {
        const y = layerY(hover);
        ctx.fillStyle = 'rgba(179, 166, 207, 0.05)';
        ctx.fillRect(0, y - 10, w, 20);
      }

      for (let i = 0; i < LAYERS; i += 1) {
        const base = layerY(i);
        const amp = usable * (0.006 + 0.006 * hash(i + 11));
        const phase = hash(i + 5) * Math.PI * 2;
        const active = i === hover;

        ctx.beginPath();
        for (let x = 0; x <= w; x += 3) {
          const u = x / w;
          const y =
            base +
            Math.sin(u * Math.PI * 2 + phase + time * 0.12) * amp +
            Math.sin(u * Math.PI * 7 - phase) * amp * 0.4;
          if (x === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.strokeStyle = active
          ? 'rgba(179, 166, 207, 0.55)'
          : `rgba(233, 228, 216, ${0.14 + hash(i + 2) * 0.12})`;
        ctx.lineWidth = active ? 1.3 : 1;
        ctx.stroke();

        for (let s = 0; s < STEPS; s += 1) {
          if (!patterns[i][s]) continue;
          const x = s * stepW + stepW / 2;
          const intensity = triggers[i][s];
          const radius = active ? 3.1 : 2.1;

          if (intensity > 0.02) {
            ctx.beginPath();
            ctx.arc(x, base, radius + intensity * 5, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(179, 166, 207, ${0.12 + intensity * 0.85})`;
            ctx.fill();
          }
          ctx.beginPath();
          ctx.arc(x, base, radius, 0, Math.PI * 2);
          ctx.fillStyle = active
            ? 'rgba(233, 228, 216, 0.55)'
            : `rgba(233, 228, 216, ${0.3 + intensity * 0.6})`;
          ctx.fill();
        }
      }
    };

    const readout = () => {
      if (!labelEl || !valueEl || !unitEl) return;
      if (hover >= 0) {
        const hits = patterns[hover].filter(Boolean).length;
        labelEl.textContent = `${probe} ${String(hover + 1).padStart(2, '0')}/${String(LAYERS).padStart(2, '0')}`;
        valueEl.textContent = `${hits} de ${STEPS}`;
        unitEl.textContent = pulses;
      } else {
        const hits = patterns.reduce((acc, pattern) => acc + (pattern[stepIndex] ? 1 : 0), 0);
        labelEl.textContent = `${stepWord} ${String(stepIndex + 1).padStart(2, '0')}/${STEPS}`;
        valueEl.textContent = String(hits);
        unitEl.textContent = events;
      }
    };

    const tick = (now: number) => {
      const p = ((now / 1000) * 0.12) % 1;
      const step = Math.floor(p * STEPS);
      playhead = p;
      if (step !== stepIndex) {
        stepIndex = step;
        for (let i = 0; i < LAYERS; i += 1) {
          if (patterns[i][step]) triggers[i][step] = 1;
        }
        readout();
      }
      for (let i = 0; i < LAYERS; i += 1) {
        for (let s = 0; s < STEPS; s += 1) {
          if (triggers[i][s] > 0) triggers[i][s] = Math.max(0, triggers[i][s] - 0.055);
        }
      }
      draw();
      raf = requestAnimationFrame(tick);
    };

    const resize = () => {
      if (!ctx) return;
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw();
    };

    const updateHover = (event: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      const y = event.clientY - rect.top;
      const pad = 26;
      const usable = Math.max(1, rect.height - pad * 2);
      const p = (y - pad) / usable;
      hover = p < 0 || p > 1 ? -1 : Math.round(p * (LAYERS - 1));
      readout();
      if (reduce) draw();
    };

    const clearHover = () => {
      hover = -1;
      readout();
      if (reduce) draw();
    };

    canvas.addEventListener('pointermove', updateHover);
    canvas.addEventListener('pointerleave', clearHover);
    window.addEventListener('resize', resize, { passive: true });

    resize();
    if (reduce) {
      playhead = 0.42;
      stepIndex = Math.floor(playhead * STEPS);
      patterns.forEach((pattern, i) => {
        pattern.forEach((on, s) => {
          triggers[i][s] = on && s === stepIndex ? 0.85 : 0;
        });
      });
      readout();
      draw();
    } else {
      readout();
      raf = requestAnimationFrame(tick);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) cancelAnimationFrame(raf);
        else raf = requestAnimationFrame(tick);
      });
    }
  }
</script>
